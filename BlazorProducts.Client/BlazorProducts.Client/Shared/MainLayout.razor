@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorProducts.Client.AuthProviders
@* @inject AuthenticationStateProvider AuthStateProvider *@
@inject NavigationManager Navigation

<div class="page">
    <AuthorizeView>
        <Authorized>
            <div class="sidebar">
                <NavMenu />
            </div>
        </Authorized>
    </AuthorizeView>

    <div class="main">
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="ml-md-auto">Welcome, @context.User.Identity?.Name!</span>
                    <a href="#" @onclick="Logout" @onclick:preventDefault="true" class="ml-3">Logout</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="ml-md-auto">Login</a>
                </NotAuthorized>
            </AuthorizeView>
            <a href="http://blazor.net" target="_blank" class="ml-3">About</a>
        </div>

        <div class="content px-4">
            <CascadingValue Name="HeadingColor" Value="@_color">
                @Body
            </CascadingValue>
        </div>
    </div>
</div>

@code {
    private readonly string _color = "#0505b5";

